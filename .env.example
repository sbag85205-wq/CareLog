# CareLog 환경변수 템플릿 (값 없이 커밋됩니다)
# 실제 값은 .env.local 에만 넣고 절대 커밋하지 마세요.
# 가상 데이터 데모(/)는 아래 값이 없어도 동작합니다 (localStorage).
# 환자 로그인(/login)은 Supabase 값이 모두 있어야 동작하고, 없으면 "설정 없음" 안내만 표시합니다.

# --- 개발용: DB 전환 대비 가상 네트워크 지연(ms). 0 또는 비우면 지연 없음 ---
NEXT_PUBLIC_CARELOG_FAKE_LATENCY_MS=

# --- Supabase 환자 로그인·DB 모드 (/login, /my) — carelog-dev 전용 ---
# 공개 값: 대시보드 Project Settings → API Keys (Publishable key), Data API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키 (Secret key, 구 service_role) — 브라우저에 노출 금지, 출력·커밋 금지
SUPABASE_SECRET_KEY=
# (구 이름도 인식: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)

# --- Supabase CLI (원격 개발용 프로젝트 migration, supabase/README.md 참조) ---
# 공유 서버에서는 명령줄 인자로 넘기지 말고 .env.local 에만 저장 (chmod 600)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- 식약처 의약품 제품 허가정보 API (공공데이터포털 15095677, 내 약 → 약 추가 검색) ---
# 공공데이터포털 "Decoding" 인증키. 서버(/api/medications/search)에서만 사용 — NEXT_PUBLIC_ 붙이지 말 것
# 없으면 검색만 "사용할 수 없음"으로 표시되고 약 이름 직접 입력·저장은 그대로 동작
MFDS_SERVICE_KEY=
