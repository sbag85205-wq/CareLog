# CareLog 환경변수 템플릿 (값 없이 커밋됩니다)
# 실제 값은 .env.local 에만 넣고 절대 커밋하지 마세요.
# 현재 프로토타입은 아래 값이 없어도 동작합니다 (가상 데이터 + localStorage).

# --- 개발용: DB 전환 대비 가상 네트워크 지연(ms). 0 또는 비우면 지연 없음 ---
NEXT_PUBLIC_CARELOG_FAKE_LATENCY_MS=

# --- 향후 Supabase 연동 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# --- 향후 식약처 공공데이터 API (의약품개요정보 e약은요) ---
# 서버 Route Handler 에서만 사용
MFDS_API_KEY=
